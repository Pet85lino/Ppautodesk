  <!-- ═══════════════════════════════════════════════════════════════════════
       NuGet packages (shared across all versions)
  ═══════════════════════════════════════════════════════════════════════════ -->
  <ItemGroup>
    <!-- Windows Registry access used by VersionDetector -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <!-- Serialisation -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Embedded SQLite for local caching / persistence -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <!-- Excel export -->
    <PackageReference Include="EPPlus" Version="7.0.0" />
    <!-- Geospatial operations -->
    <PackageReference Include="NetTopologySuite" Version="2.5.0" />
    <!-- Structured logging -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <!-- CSV import/export -->
    <PackageReference Include="CsvHelper" Version="31.0.0" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Core connector source files (explicit, so SDK does not exclude them)
  ═══════════════════════════════════════════════════════════════════════════ -->
  <ItemGroup>
    <Compile Include="Core\VersionDetector.cs" />
    <Compile Include="Core\ApiVersionAdapter.cs" />
    <Compile Include="Core\ConnectorBase.cs" />
    <Compile Include="Core\TransactionManager.cs" />
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Content / data files
  ═══════════════════════════════════════════════════════════════════════════ -->
  <ItemGroup>
    <None Update="Standards\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════
       Build diagnostics target
  ═══════════════════════════════════════════════════════════════════════════ -->
  <Target Name="PrintCivilVersion" BeforeTargets="Build">
    <Message Text="[Civil3DConnector] Building for Civil 3D $(Civil3DVersion) — InstallPath: $(Civil3DInstallPath)"
             Importance="high" />
  </Target>

</Project>
