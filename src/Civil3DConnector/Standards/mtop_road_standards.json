{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MTOP Road Design Standards - Ecuador",
  "description": "Normas de diseño geométrico de carreteras del Ministerio de Transporte y Obras Públicas del Ecuador (MTOP). Basado en la Norma Ecuatoriana Vial NEVI-12-MTOP.",
  "version": "NEVI-12",
  "authority": "MTOP - Ministerio de Transporte y Obras Públicas del Ecuador",
  "lastUpdated": "2024-01-01",
  "references": [
    "NEVI-12-MTOP: Norma Ecuatoriana Vial, Volumen 2B - Diseño de Carreteras",
    "AASHTO A Policy on Geometric Design of Highways and Streets (adaptado)",
    "Manual de Capacidad de Carreteras HCM (adaptado MTOP)"
  ],

  "roadClassification": {
    "description": "Clasificación funcional de carreteras en Ecuador",
    "E": {
      "name": "Autopista / Autovía",
      "description": "Carreteras de acceso controlado, doble calzada, diseño de alta velocidad",
      "function": "Movimiento de tráfico de larga distancia a alta velocidad",
      "accessControl": "Control total de accesos",
      "designSpeedRange_kph": [80, 120],
      "annualAverageDailyTraffic_min": 8000
    },
    "R1": {
      "name": "Carretera Primaria de dos carriles",
      "description": "Red vial primaria, dos carriles, conexiones interprovinciales principales",
      "function": "Conectividad interprovincial y regional",
      "accessControl": "Acceso parcialmente controlado",
      "designSpeedRange_kph": [60, 100],
      "annualAverageDailyTraffic_range": [3000, 8000]
    },
    "R2": {
      "name": "Carretera Secundaria",
      "description": "Red vial secundaria, conexiones entre cantones",
      "function": "Conectividad cantonal e intercantonal",
      "designSpeedRange_kph": [40, 80],
      "annualAverageDailyTraffic_range": [500, 3000]
    },
    "R3": {
      "name": "Carretera Terciaria",
      "description": "Red vial terciaria, caminos vecinales y rurales",
      "function": "Acceso a zonas rurales y comunidades",
      "designSpeedRange_kph": [20, 40],
      "annualAverageDailyTraffic_max": 500
    },
    "U_A": {
      "name": "Vía Arterial Urbana",
      "description": "Vías de gran capacidad en zonas urbanas",
      "designSpeedRange_kph": [50, 80]
    },
    "U_C": {
      "name": "Vía Colectora Urbana",
      "description": "Vías que distribuyen el tráfico hacia las arteriales",
      "designSpeedRange_kph": [30, 50]
    },
    "U_L": {
      "name": "Vía Local Urbana",
      "description": "Calles de acceso a propiedades",
      "designSpeedRange_kph": [20, 30]
    }
  },

  "terrainTypes": {
    "plano": {
      "code": "P",
      "description": "Pendiente transversal del terreno natural < 5%, longitudinal < 3%",
      "maxLongitudinalGrade_percent": 3
    },
    "ondulado": {
      "code": "O",
      "description": "Pendiente transversal del terreno 5-25%, longitudinal 3-6%",
      "maxLongitudinalGrade_percent": 6
    },
    "montanoso": {
      "code": "M",
      "description": "Pendiente transversal > 25%, longitudinal > 6%",
      "maxLongitudinalGrade_percent": 12
    },
    "escarpado": {
      "code": "E",
      "description": "Pendiente transversal > 60%, terreno muy accidentado",
      "maxLongitudinalGrade_percent": 15
    }
  },

