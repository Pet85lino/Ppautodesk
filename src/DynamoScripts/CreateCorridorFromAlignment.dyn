    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "node_create_corridor_python",
      "Inputs": [
        {
          "Id": "py_in_alignment",
          "Name": "IN[0]",
          "Description": "Alignment object",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "py_in_profile",
          "Name": "IN[1]",
          "Description": "Profile object",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "py_in_assembly",
          "Name": "IN[2]",
          "Description": "Assembly object",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "py_in_corridor_name",
          "Name": "IN[3]",
          "Description": "Corridor name string",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "py_in_start_station",
          "Name": "IN[4]",
          "Description": "Start station in metres",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "py_in_sample_spacing",
          "Name": "IN[5]",
          "Description": "Sample spacing in metres",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "py_out_corridor",
          "Name": "OUT",
          "Description": "[corridor_object, status_string]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Creates the corridor object with baseline, region, and rebuild.",
      "Script": "# CreateCorridorFromAlignment – CPython 3 node\n# Inputs: alignment, profile, assembly, corridor_name, start_station, sample_spacing\n# Output: [corridor_object, status_message]\n\nimport clr\nclr.AddReference('AcMgd')\nclr.AddReference('AcDbMgd')\nclr.AddReference('AcCoreMgd')\nclr.AddReference('Autodesk.Civil.ApplicationServices')\nclr.AddReference('Autodesk.Civil.DatabaseServices')\nclr.AddReference('AeccXUiRoadway')\n\nimport traceback\n\ntry:\n    import Autodesk.AutoCAD.ApplicationServices as AcApp\n    import Autodesk.AutoCAD.DatabaseServices as AcDb\n    import Autodesk.Civil.ApplicationServices as CivilApp\n    import Autodesk.Civil.DatabaseServices as CivilDb\n\n    alignment    = IN[0]\n    profile      = IN[1]\n    assembly     = IN[2]\n    corridor_name  = str(IN[3]) if IN[3] else 'Corridor-1'\n    start_station  = float(IN[4]) if IN[4] is not None else 0.0\n    sample_spacing = float(IN[5]) if IN[5] is not None else 5.0\n\n    doc      = CivilApp.CivilApplication.ActiveDocument\n    acad_doc = AcApp.Application.DocumentManager.MdiActiveDocument\n    db       = acad_doc.Database\n\n    corridor = None\n    status   = ''\n\n    with AcDb.Transaction() as tr:\n        # Determine end station from alignment length\n        align_obj = tr.GetObject(alignment.ObjectId, AcDb.OpenMode.ForRead)\n        end_station = float(align_obj.EndingStation)\n\n        # Create corridor\n        corridors = doc.CorridorCollection\n        corridor_id = corridors.Add(\n            corridor_name,\n            alignment.ObjectId,\n            profile.ObjectId,\n            assembly.ObjectId\n        )\n        corridor = tr.GetObject(corridor_id, AcDb.OpenMode.ForWrite)\n\n        # Add baseline\n        baseline = corridor.Baselines.Add(\n            alignment.ObjectId,\n            profile.ObjectId\n        )\n\n        # Add region from start to end\n        region = baseline.Regions.Add(\n            assembly.ObjectId,\n            start_station,\n            end_station\n        )\n        region.FrequencyToApplyAssemblies = sample_spacing\n\n        # Rebuild the corridor\n        corridor.Rebuild()\n\n        tr.Commit()\n\n    status = (\n        f'SUCCESS: Corridor \"{corridor_name}\" created. '\n        f'Stations {start_station:.2f}–{end_station:.2f} m. '\n        f'Spacing: {sample_spacing} m.'\n    )\n    OUT = [corridor, status]\n\nexcept Exception as e:\n    OUT = [None, f'ERROR: {str(e)}\\n{traceback.format_exc()}']\n"
    },
    {
