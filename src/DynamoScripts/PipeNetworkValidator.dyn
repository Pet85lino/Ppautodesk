      ],
      "Outputs": [{ "Id": "OUT_item", "Name": "item", "Description": "Violaciones" }],
      "Replication": "Auto",
      "Description": "Obtener violaciones de la lista"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "FunctionSignature": "DSCore.List.GetItemAtIndex@var[]..[],int",
      "NodeType": "FunctionNode",
      "Id": "n_get_summary",
      "Inputs": [
        { "Id": "IN_list2",  "Name": "list",  "Description": "Lista" },
        { "Id": "IN_index2", "Name": "index", "Description": "Índice" }
      ],
      "Outputs": [{ "Id": "OUT_summary", "Name": "item", "Description": "Resumen" }],
      "Replication": "Auto",
      "Description": "Obtener resumen de la validación"
    },
    {
