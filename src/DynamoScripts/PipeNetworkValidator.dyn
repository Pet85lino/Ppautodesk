      "NodeType": "CodeBlockNode",
      "Id": "n_index_0",
      "Code": "0;",
      "Inputs": [],
      "Outputs": [{ "Id": "OUT_0", "Name": "0", "Description": "int" }],
      "Replication": "Disabled",
      "Description": "Índice 0 - Violaciones"
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Id": "n_index_1",
      "Code": "1;",
      "Inputs": [],
      "Outputs": [{ "Id": "OUT_1", "Name": "1", "Description": "int" }],
      "Replication": "Disabled",
      "Description": "Índice 1 - Resumen"
    }
  ],
  "Connectors": [
